{
  "name": "indexwright-workspace",
  "private": true,
  "description": "Workspace root. The published packages live under packages/.",
  "license": "Apache-2.0",
  "author": "Yuki Nagai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uny/indexwright.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build --force packages/indexwright/tsconfig.json packages/record/tsconfig.json",
    "typecheck": "tsc --build packages/indexwright/tsconfig.json && tsc --noEmit -p packages/record/tsconfig.json",
    "test": "npm run build && node --test \"packages/*/test/*.test.js\"",
    "verify-package": "npm run build && node scripts/verify-package.mjs && node scripts/verify-record-package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
