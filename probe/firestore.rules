rules_version = '2';

// The emulator wants a rules file, and the deployed target is a throwaway database reached through
// application default credentials — which bypass rules entirely. Nothing here is a security control;
// it is the file the emulator refuses to start without.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
